{
  "swagger": "2.0",
  "info": {
    "title": "API Clínica Salud Integral",
    "description": "API REST para la gestión de la clínica",
    "version": "1.0.0"
  },
  "host": "localhost:3000",
  "basePath": "/",
  "schemes": [
    "http"
  ],
  "paths": {
    "/api/specialties": {
      "get": {
        "tags": [
          "Specialties"
        ],
        "summary": "Lista todas las especialidades",
        "description": "",
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/patients": {
      "post": {
        "tags": [
          "Patients"
        ],
        "summary": "Registra un paciente nuevo",
        "description": "",
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "schema": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "example": "Enrique Alanis"
                },
                "email": {
                  "type": "string",
                  "example": "enrique@gmail.com"
                },
                "birthDate": {
                  "type": "string",
                  "example": "1995-03-15"
                },
                "phone": {
                  "type": "string",
                  "example": "8441234567"
                }
              }
            }
          }
        ],
        "responses": {
          "201": {
            "description": "Created"
          },
          "400": {
            "description": "Bad Request"
          },
          "409": {
            "description": "Conflict"
          },
          "500": {
            "description": "Internal Server Error"
          }
        }
      },
      "get": {
        "tags": [
          "Patients"
        ],
        "summary": "Lista todos los pacientes",
        "description": "",
        "responses": {
          "200": {
            "description": "OK"
          },
          "500": {
            "description": "Internal Server Error"
          }
        }
      }
    },
    "/api/patients/{id}": {
      "get": {
        "tags": [
          "Patients"
        ],
        "summary": "Obtiene un paciente por su id",
        "description": "",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "type": "string"
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          },
          "400": {
            "description": "Bad Request"
          },
          "404": {
            "description": "Not Found"
          },
          "500": {
            "description": "Internal Server Error"
          }
        }
      }
    },
    "/api/doctors": {
      "get": {
        "tags": [
          "Doctors"
        ],
        "summary": "Lista los médicos, con filtro opcional por especialidad",
        "description": "",
        "parameters": [
          {
            "name": "specialty",
            "in": "query",
            "description": "Nombre de la especialidad, por ejemplo: Pediatria",
            "required": false,
            "type": "string"
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          },
          "500": {
            "description": "Internal Server Error"
          }
        }
      }
    }
  }
}